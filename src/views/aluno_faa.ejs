<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ficha de Autoavaliação (FAA)</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/header') %>

    <main class="container">
        <%- include('partials/flash') %>

        <h2>Ficha de Autoavaliação (FAA)</h2>
        <p class="text-muted page-subtitle">
            Preencha os dados abaixo. A ficha é salva automaticamente ao gerar o PDF.
        </p>

        <% if (faaSalva) { %>
            <div class="faa-saved">
                <div>
                    <strong>Ficha salva.</strong>
                    <span class="text-muted">
                        Última atualização em <%= new Date(faaSalva.atualizado_em).toLocaleString('pt-BR') %>.
                    </span>
                </div>
                <a href="/aluno/faa/pdf" class="btn btn-secondary">Gerar PDF novamente</a>
            </div>
        <% } %>

        <%
            const criterios = [
                { numero: '1.1', titulo: 'Rendimento do Estagiário' },
                { numero: '1.2', titulo: 'Facilidade de Compreensão' },
                { numero: '1.3', titulo: 'Conhecimentos Técnicos' },
                { numero: '1.4', titulo: 'Organização e método de trabalho' },
                { numero: '1.5', titulo: 'Iniciativa e Independência' },
                { numero: '2.1', titulo: 'Assiduidade' },
                { numero: '2.2', titulo: 'Disciplina' },
                { numero: '2.3', titulo: 'Sociabilidade e desempenho' },
                { numero: '2.4', titulo: 'Cooperação' },
                { numero: '2.5', titulo: 'Responsabilidade' },
            ];

            const perguntas = [
                'A empresa ofereceu condições adequadas?',
                'O estágio atendeu às suas expectativas?',
                'O estágio contribuiu para sua formação profissional?',
                'Recomendaria este estágio para outro aluno?',
                'O curso técnico o capacitou adequadamente para o estágio?',
                'O orientador acompanhou adequadamente seu estágio?',
                'O supervisor acompanhou adequadamente seu estágio?',
            ];

            const mediaInicial = notasSalvas.length === 10
                ? (notasSalvas.reduce((soma, nota) => soma + Number(nota), 0) / notasSalvas.length)
                    .toFixed(2)
                    .replace('.', ',')
                : '0,00';
        %>

        <form action="/aluno/faa" method="POST" class="faa-form">
            <section class="card">
                <h2>Dados do estágio</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label for="periodo">Período do estágio</label>
                        <input type="text" id="periodo" name="periodo" required
                            value="<%= periodo %>" placeholder="Ex.: 01/03/2026 a 30/09/2026">
                    </div>

                    <div class="form-field">
                        <label for="data_assinatura">Data da assinatura</label>
                        <input type="date" id="data_assinatura" name="data_assinatura" required value="<%= dataAssinatura %>">
                    </div>
                </div>
                <div class="form-note">
                    <strong>Empresa/Entidade concedente:</strong>
                    <% if (empresa) { %>
                        <%= empresa %> (cadastrada pelo professor do estágio)
                    <% } else { %>
                        ainda não cadastrada pelo professor.
                    <% } %>
                </div>
            </section>

            <section class="card">
                <div class="card-header">
                    <h2>Aspectos avaliados</h2>
                    <span class="text-muted">Notas de 0 a 10</span>
                </div>
                <p class="text-muted">
                    Atribua uma nota para cada critério. A nota final é a média aritmética dos 10 itens.
                </p>

                <div class="faa-notas">
                    <% criterios.forEach((criterio, indice) => { %>
                        <div class="faa-nota">
                            <label for="nota_<%= indice + 1 %>">
                                <span class="faa-nota-num"><%= criterio.numero %></span>
                                <%= criterio.titulo %>
                            </label>
                            <input type="number" id="nota_<%= indice + 1 %>" name="nota_<%= indice + 1 %>"
                                min="0" max="10" step="0.1" required data-faa-nota
                                value="<%= notasSalvas[indice] != null ? notasSalvas[indice] : '' %>">
                        </div>
                    <% }) %>
                </div>

                <p class="faa-media">Nota final: <strong id="faa-media"><%= mediaInicial %></strong></p>
            </section>

            <section class="card">
                <h2>Avaliação do estágio e do curso técnico</h2>
                <div class="form-grid">
                    <% perguntas.forEach((pergunta, indice) => { %>
                        <div class="form-field">
                            <label for="q_<%= indice + 1 %>"><%= indice + 1 %>. <%= pergunta %></label>
                            <select id="q_<%= indice + 1 %>" name="q_<%= indice + 1 %>" required>
                                <option value="">Selecione</option>
                                <option value="sim" <%= respostasSalvas[indice] === 'sim' ? 'selected' : '' %>>Sim</option>
                                <option value="nao" <%= respostasSalvas[indice] === 'nao' ? 'selected' : '' %>>Não</option>
                                <option value="mais_menos" <%= respostasSalvas[indice] === 'mais_menos' ? 'selected' : '' %>>+/-</option>
                            </select>
                        </div>
                    <% }) %>
                </div>
            </section>

            <section class="card">
                <h2>Atividades e observações</h2>

                <label for="atividades">Principais atividades executadas na empresa</label>
                <textarea id="atividades" name="atividades" required><%= atividadesTexto %></textarea>

                <label for="comentarios">Comentários/observações</label>
                <textarea id="comentarios" name="comentarios"
                    placeholder="Opcional"><%= comentarios %></textarea>
            </section>

            <div class="button-group form-actions">
                <button type="submit" name="acao" value="salvar_pdf">
                    <%= faaSalva ? 'Salvar alterações e gerar PDF' : 'Salvar e gerar PDF' %>
                </button>
                <button type="submit" name="acao" value="salvar" class="btn btn-secondary">
                    Salvar sem gerar PDF
                </button>
                <a href="/aluno/dashboard" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
