<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meu estágio · Controle de Estágio</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

    <%- include('partials/header') %>

    <main id="conteudo" class="container">
        <%- include('partials/flash') %>

        <%
            const st = estagioStatus(aluno);
            const abaSelecionada = ['atividades', 'fichas'].includes(abaInicial) ? abaInicial : 'resumo';
            const primeiroNome = String(aluno.nome || '').trim().split(/\s+/)[0] || '';
            const emAndamento = aluno.status === 'em_andamento';
            const podeAlterarAtividades = emAndamento && !aluno.arquivado && !aluno.encerrado_em;
            const concluidoHoras = aluno.status === 'concluido';
            const percentPendente = cargaHoraria > 0
                ? Math.max(0, Math.min(100 - percentual, Math.round((horasPendentes / cargaHoraria) * 100)))
                : 0;
            const etapa = encerrado ? 3 : (concluidoHoras ? 2 : (emAndamento ? 1 : 0));
            const etapas = ['Cadastro', 'Atividades', 'Fichas e banca', 'Encerrado'];
        %>

        <div class="page-head">
            <div>
                <h1>Olá, <%= primeiroNome %></h1>
                <p>Acompanhe suas horas, registre atividades e emita suas fichas.</p>
            </div>
            <span class="status <%= st.classe %>"><%= st.label %></span>
        </div>

        <% if (banca) { %>
            <section class="card" aria-labelledby="minha-banca">
                <div class="card-header"><h2 id="minha-banca">Sua banca de estágio</h2><span class="status <%= banca.situacao === 'cancelada' ? 'status-invalidated' : 'status-progress' %>"><%= situacoesBanca[banca.situacao] %></span></div>
                <% if (banca.situacao === 'cancelada') { %><p>A banca foi cancelada. Aguarde um novo agendamento do orientador.</p>
                <% } else { %>
                    <p><strong><%= dataBr(banca.data) %> · <%= banca.hora_inicio %> às <%= banca.hora_fim %></strong> (horário de Brasília)</p>
                    <p><strong>Local:</strong> <%= banca.sala %><% if (banca.link_reuniao) { %> · <a href="<%= banca.link_reuniao %>" target="_blank" rel="noopener noreferrer">Acessar reunião</a><% } %></p>
                    <dl class="agenda-people"><div><dt>Orientador</dt><dd><%= banca.orientador_nome %></dd></div><div><dt>Avaliadores</dt><dd><%= banca.avaliador_1_nome %> e <%= banca.avaliador_2_nome %></dd></div></dl>
                    <% if (banca.observacoes) { %><p class="text-muted"><%= banca.observacoes %></p><% } %>
                <% } %>
            </section>
        <% } %>

        <% if (encerrado) { %>
            <div class="aviso aviso-ok" role="status">
                <%- icone('check') %>
                <div>
                    <strong>Estágio encerrado em <%= dataBr(aluno.encerrado_em) %></strong>
                    Seus dados estão fechados para edição. Você pode consultar e imprimir todos os documentos na aba Fichas.
                </div>
            </div>
        <% } %>

        <div class="situacao">
            <section class="card" aria-labelledby="titulo-horas">
                <h2 id="titulo-horas">Suas horas</h2>
                <p class="horas-grandes"><%= horasRealizadas %><span>h validadas de <%= cargaHoraria %>h</span></p>
                <div class="progress" role="img" aria-label="<%= percentual %>% das horas validadas">
                    <div class="progress-bar" data-percent="<%= percentual %>"></div>
                    <div class="progress-pending" data-percent="<%= percentPendente %>"></div>
                </div>
                <div class="progress-legend">
                    <span><i class="lg-ok"></i> Validadas: <%= horasRealizadas %>h</span>
                    <span><i class="lg-pend"></i> Aguardando validação: <%= horasPendentes %>h</span>
                    <span><i></i> Faltam: <%= horasRestantes %>h</span>
                </div>

                <ol class="trilha" aria-label="Etapas do estágio">
                    <% etapas.forEach((nome, i) => { %>
                        <li class="<%= i < etapa ? 'feita' : (i === etapa ? 'atual' : '') %>" <%- i === etapa ? 'aria-current="step"' : '' %>><%= nome %></li>
                    <% }) %>
                </ol>
            </section>

            <section class="card proximo-passo" aria-labelledby="titulo-passo">
                <div>
                    <% if (aluno.status === 'lista_espera') { %>
                        <h2 id="titulo-passo">Aguardando aprovação</h2>
                        <p>Um professor vai aprovar seu cadastro e definir seu supervisor e orientador. Você será liberado para registrar atividades em seguida.</p>
                    <% } else if (emAndamento) { %>
                        <h2 id="titulo-passo">Registre a atividade de hoje</h2>
                        <p>Anote o horário de entrada e saída e o que você fez.
                            <% if (horasPendentes > 0) { %> Você tem <%= horasPendentes %>h esperando validação do supervisor.<% } %></p>
                    <% } else if (!encerrado && !faaSalva) { %>
                        <h2 id="titulo-passo">Preencha a sua FAA</h2>
                        <p>Você cumpriu as <%= cargaHoraria %>h. Falta a ficha de autoavaliação, que entra na nota final da banca.</p>
                    <% } else if (!encerrado) { %>
                        <h2 id="titulo-passo">Aguarde a banca</h2>
                        <p>Sua FAA está salva. O orientador vai lançar as notas da banca e concluir o estágio. Você pode corrigir a FAA até lá.</p>
                    <% } else { %>
                        <h2 id="titulo-passo">Imprima seus documentos</h2>
                        <p>Todas as fichas e a ata da banca estão prontas para impressão.</p>
                    <% } %>
                </div>
                <% if (podeAlterarAtividades) { %>
                    <a href="/aluno/nova-atividade" class="btn"><%- icone('mais') %> Nova atividade</a>
                <% } else if (concluidoHoras && !encerrado) { %>
                    <a href="/aluno/faa" class="btn"><%- icone('caneta') %> <%= faaSalva ? 'Revisar a FAA' : 'Preencher a FAA' %></a>
                <% } else if (encerrado) { %>
                    <a href="/aluno/dashboard?aba=fichas" class="btn"><%- icone('imprimir') %> Ver documentos</a>
                <% } %>
            </section>
        </div>

        <section class="student-dashboard-tabs" data-dashboard-tabs>
            <div class="dashboard-tab-list" role="tablist" aria-label="Seções do painel">
                <% [['resumo', 'Resumo'], ['atividades', 'Atividades'], ['fichas', 'Fichas']].forEach(([chave, rotulo]) => { %>
                    <button type="button" class="dashboard-tab <%= abaSelecionada === chave ? 'is-active' : '' %>" id="tab-<%= chave %>" role="tab"
                        aria-selected="<%= abaSelecionada === chave %>" aria-controls="panel-<%= chave %>" tabindex="<%= abaSelecionada === chave ? '0' : '-1' %>"><%= rotulo %></button>
                <% }) %>
            </div>

            <!-- Resumo -->
            <section class="dashboard-tab-panel" id="panel-resumo" role="tabpanel" aria-labelledby="tab-resumo" tabindex="0" <%= abaSelecionada === 'resumo' ? '' : 'hidden' %>>
                <div class="card">
                    <h2>Dados do estágio</h2>
                    <dl class="summary-details">
                        <div><dt>Aluno</dt><dd><%= aluno.nome %></dd></div>
                        <div><dt>Matrícula</dt><dd><%= aluno.matricula || '—' %></dd></div>
                        <div><dt>Curso</dt><dd><%= aluno.curso || 'Não informado' %></dd></div>
                        <div><dt>Empresa ou entidade concedente</dt><dd><%= aluno.empresa || '—' %></dd></div>
                        <div><dt>Supervisor</dt><dd><%= aluno.supervisor_nome || '—' %></dd></div>
                        <div><dt>Orientador</dt><dd><%= aluno.orientador_nome || '—' %></dd></div>
                        <div><dt>Carga horária</dt><dd><%= cargaHoraria %>h</dd></div>
                    </dl>
                </div>
            </section>

            <!-- Atividades -->
            <section class="dashboard-tab-panel" id="panel-atividades" role="tabpanel" aria-labelledby="tab-atividades" tabindex="0" <%= abaSelecionada === 'atividades' ? '' : 'hidden' %>>
                <div class="atividade-layout">
                    <div class="card atividade-calendario">
                        <h2>Calendário</h2>
                        <p class="text-muted" style="margin-bottom: 12px;">Toque em um dia para ver as atividades. Você pode registrar de segunda a sábado, mesmo fora dos dias planejados; domingo não permite registro.</p>
                        <%- include('partials/calendario', { dados: calendario, modo: 'ver', hoje, selecionado: '', podeRegistrar: podeAlterarAtividades, horariosTrabalho }) %>
                        <div class="dia-resumo" data-cal-painel aria-live="polite" hidden></div>
                    </div>

                    <section class="card atividade-historico">
                        <div class="card-header">
                            <div>
                                <h2>Histórico</h2>
                                <p class="text-muted"><%= atividades.length %> atividade(s) · validadas pelo seu supervisor</p>
                            </div>
                            <% if (podeAlterarAtividades) { %>
                                <a href="/aluno/nova-atividade" class="btn btn-success btn-sm"><%- icone('mais') %> Nova atividade</a>
                            <% } %>
                        </div>
                        <div class="table-wrap">
                            <table class="activity-history-table">
                                <thead>
                                    <tr><th>Data</th><th>Horário</th><th>Descrição</th><th>Horas</th><th>Situação</th><th>Ações</th></tr>
                                </thead>
                                <tbody>
                                    <% if (atividades.length === 0) { %>
                                        <tr><td colspan="6">Nenhuma atividade registrada ainda.</td></tr>
                                    <% } else { %>
                                        <% atividades.forEach((atividade) => { %>
                                            <tr data-dia="<%= dataIso(atividade.data) %>">
                                                <td><%= dataBr(atividade.data) %></td>
                                                <td>
                                                    <% if (atividade.hora_inicio && atividade.hora_fim) { %>
                                                        <%= atividade.hora_inicio.slice(0, 5) %> – <%= atividade.hora_fim.slice(0, 5) %>
                                                    <% } else { %>—<% } %>
                                                </td>
                                                <td class="activity-description" title="<%= atividade.descricao %>"><%= atividade.descricao %></td>
                                                <td><%= Number(atividade.horas) %>h</td>
                                                <td><%- include('partials/status_atividade', { atividade }) %></td>
                                                <td class="activity-actions">
                                                    <% if (podeAlterarAtividades) { %>
                                                        <div class="activity-action-group">
                                                            <a href="/aluno/atividade/<%= atividade.id %>/editar" class="activity-action" title="Editar atividade" aria-label="Editar atividade de <%= dataBr(atividade.data) %>">
                                                                <%- icone('caneta') %>
                                                            </a>
                                                            <form action="/aluno/atividade/<%= atividade.id %>/excluir" method="POST">
                                                                <button type="submit" class="activity-action activity-action-danger" title="Excluir atividade" aria-label="Excluir atividade de <%= dataBr(atividade.data) %>" data-confirmar="Excluir esta atividade? A ação não pode ser desfeita e, se as horas estiverem validadas, elas serão removidas do total.">
                                                                    <%- icone('lixeira') %>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    <% } else { %>—<% } %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <p class="text-muted" data-cal-filtro hidden style="margin-top: 12px;">
                            Mostrando só o dia selecionado. <button type="button" class="btn-ghost btn-sm" data-cal-limpar>Mostrar todas</button>
                        </p>
                    </section>
                </div>
            </section>

            <!-- Fichas -->
            <section class="dashboard-tab-panel" id="panel-fichas" role="tabpanel" aria-labelledby="tab-fichas" tabindex="0" <%= abaSelecionada === 'fichas' ? '' : 'hidden' %>>
                <div class="card fichas-center">
                    <h2>Fichas do estágio</h2>
                    <p class="text-muted">Documentos gerados com os dados do seu estágio, prontos para imprimir.</p>

                    <div class="fichas-grid">
                        <article class="ficha-item <%= aluno.status !== 'lista_espera' ? 'pronta' : '' %>">
                            <div class="ficha-item-head">
                                <span class="ficha-icon"><%- icone('lista') %></span>
                                <div>
                                    <h3>Ficha de acompanhamento</h3>
                                    <p>Datas, horários, atividades e horas validadas.</p>
                                </div>
                            </div>
                            <% if (aluno.status !== 'lista_espera') { %>
                                <a href="/aluno/ficha-acompanhamento" class="btn btn-success"><%- icone('baixar') %> Baixar PDF</a>
                            <% } else { %>
                                <span class="ficha-status text-muted"><%- icone('cadeado', 16) %> Disponível quando o estágio começar</span>
                            <% } %>
                        </article>

                        <article class="ficha-item <%= faaSalva || faaRascunho ? 'pronta' : '' %>">
                            <div class="ficha-item-head">
                                <span class="ficha-icon"><%- icone('caneta') %></span>
                                <div>
                                    <h3>FAA · Autoavaliação</h3>
                                    <p>Sua avaliação do estágio, com notas e comentários.</p>
                                </div>
                            </div>
                            <% if (concluidoHoras && !encerrado) { %>
                                <div class="button-group">
                                    <a href="/aluno/faa" class="btn btn-success"><%- icone('caneta') %> <%= faaSalva ? 'Revisar' : (faaRascunho ? 'Continuar rascunho' : 'Preencher') %></a>
                                    <% if (faaSalva) { %><a href="/aluno/faa/pdf" class="btn btn-secondary"><%- icone('baixar') %> PDF</a><% } %>
                                </div>
                            <% } else if (encerrado) { %>
                                <% if (faaSalva) { %>
                                    <a href="/aluno/faa/pdf" class="btn btn-success"><%- icone('baixar') %> Baixar PDF</a>
                                <% } else { %>
                                    <span class="ficha-status text-muted">Não foi preenchida</span>
                                <% } %>
                            <% } else { %>
                                <span class="ficha-status text-muted"><%- icone('cadeado', 16) %> Disponível ao cumprir as horas</span>
                            <% } %>
                        </article>

                        <article class="ficha-item <%= facSalva ? 'pronta' : '' %>">
                            <div class="ficha-item-head"><span class="ficha-icon"><%- icone('usuario') %></span><div><h3>FAC · Avaliação do supervisor</h3><p>Preenchida pelo supervisor do estágio.</p></div></div>
                            <% if (facSalva) { %><a href="/aluno/fac/pdf" class="btn btn-success"><%- icone('baixar') %> Baixar PDF</a>
                            <% } else { %><span class="ficha-status text-muted">Aguardando o supervisor</span><% } %>
                        </article>

                        <article class="ficha-item <%= fapoSalva && concluidoHoras ? 'pronta' : '' %>">
                            <div class="ficha-item-head">
                                <span class="ficha-icon"><%- icone('usuario') %></span>
                                <div>
                                    <h3>FAPO · Avaliação do orientador</h3>
                                    <p>Preenchida pelo seu professor orientador.</p>
                                </div>
                            </div>
                            <% if (concluidoHoras && fapoSalva) { %>
                                <a href="/aluno/fapo/pdf" class="btn btn-success"><%- icone('baixar') %> Baixar PDF</a>
                            <% } else if (concluidoHoras) { %>
                                <span class="ficha-status text-muted">Aguardando o orientador</span>
                            <% } else { %>
                                <span class="ficha-status text-muted"><%- icone('cadeado', 16) %> Disponível ao cumprir as horas</span>
                            <% } %>
                        </article>

                        <article class="ficha-item <%= encerrado ? 'pronta' : '' %>">
                            <div class="ficha-item-head">
                                <span class="ficha-icon"><%- icone('escudo') %></span>
                                <div>
                                    <h3>Ata da banca</h3>
                                    <p>Notas, resultado e assinaturas da banca de avaliação.</p>
                                </div>
                            </div>
                            <% if (encerrado) { %>
                                <a href="/aluno/fare/pdf" class="btn btn-success"><%- icone('baixar') %> Baixar PDF</a>
                            <% } else if (concluidoHoras) { %>
                                <span class="ficha-status text-muted">Aguardando o orientador concluir o estágio</span>
                            <% } else { %>
                                <span class="ficha-status text-muted"><%- icone('cadeado', 16) %> Disponível no fim do estágio</span>
                            <% } %>
                        </article>
                    </div>
                </div>
            </section>
        </section>
    </main>

    <% if (podeAlterarAtividades) { %>
        <a href="/aluno/nova-atividade" class="btn fab" aria-label="Registrar nova atividade"><%- icone('mais') %> Atividade</a>
    <% } %>

    <%- include('partials/footer') %>
</body>
</html>
