<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Painel do Aluno</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

    <%- include('partials/header') %>

    <main class="container">
        <%- include('partials/flash') %>

        <% const statusLabel = { lista_espera: 'Lista de Espera', em_andamento: 'Em andamento', concluido: 'Concluído' }; %>
        <% const statusClass = { lista_espera: 'status-waiting', em_andamento: 'status-progress', concluido: 'status-completed' }; %>

        <div class="card">
            <div class="card-header">
                <h2>Horas</h2>
                <span class="status <%= statusClass[aluno.status] %>"><%= statusLabel[aluno.status] %></span>
            </div>

            <p>Você tem <strong><%= horasRealizadas %>h validadas</strong> de <strong><%= cargaHoraria %>h</strong>
                (<%= percentual %>%).</p>
            <div class="progress">
                <div class="progress-bar" data-percent="<%= percentual %>"></div>
            </div>
            <p class="progress-caption text-muted">Restam <%= horasRestantes %>h</p>
            <% if (horasPendentes > 0) { %>
                <p class="progress-caption text-muted">
                    <strong><%= horasPendentes %>h</strong> aguardando validação do professor.
                </p>
            <% } %>
        </div>

        <div class="grid">
            <div class="card">
                <h2>Informações do Estágio</h2>
                <table>
                    <tr><th>Campo</th><th>Informação</th></tr>
                    <tr><td>Aluno</td><td><%= aluno.nome %></td></tr>
                    <tr><td>Matrícula</td><td><%= aluno.matricula %></td></tr>
                    <tr><td>Supervisor</td><td><%= aluno.supervisor_nome || '—' %></td></tr>
                    <tr><td>Orientador</td><td><%= aluno.orientador_nome || '—' %></td></tr>
                </table>
            </div>

            <div class="card">
                <h2>Última Atividade</h2>
                <% if (ultimaAtividade) { %>
                    <p><strong>Data:</strong> <%= new Date(ultimaAtividade.data).toLocaleDateString('pt-BR') %></p>
                    <p><strong>Descrição:</strong><br><%= ultimaAtividade.descricao %></p>
                    <p><strong>Horas:</strong> <%= ultimaAtividade.horas %>h</p>
                    <p>
                        <strong>Validação:</strong>
                        <%- include('partials/status_atividade', { atividade: ultimaAtividade }) %>
                    </p>
                    <% if (ultimaAtividade.status_validacao === 'invalidada') { %>
                        <p class="text-muted">
                            Esse registro não conta horas.
                            <% if (aluno.status === 'em_andamento') { %>
                                Faça um novo registro para substituí-lo.
                            <% } %>
                        </p>
                    <% } %>
                <% } else { %>
                    <p>Nenhuma atividade registrada ainda.</p>
                <% } %>

                <div class="card-actions">
                    <div class="button-group">
                        <% if (aluno.status === 'em_andamento') { %>
                            <a href="/aluno/nova-atividade" class="btn">Nova Atividade</a>
                        <% } %>
                    <% if (aluno.status === 'concluido') { %>
                        <a href="/aluno/faa" class="btn btn-success">Gerar PDF FAA</a>
                    <% } else { %>
                        <a href="/aluno/ficha-acompanhamento" class="btn btn-success">Gerar Ficha Acompanhamento</a>
                    <% } %>
                        <a href="/aluno/atividades" class="btn btn-secondary">Ver Todas as Atividades</a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
