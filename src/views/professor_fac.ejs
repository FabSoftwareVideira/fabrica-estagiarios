<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FAC · Avaliação do supervisor</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
    <%- include('partials/header') %>
    <main id="conteudo" class="container">
        <%- include('partials/breadcrumb', { itens: user.cargo === 'supervisor'
            ? [{ texto: 'Supervisionados', href: '/professor/dashboard' }, { texto: aluno.nome, href: '/professor/aluno/' + aluno.usuario_id }, { texto: 'FAC' }]
            : [{ texto: 'Fichas', href: '/professor/fichas' }, { texto: aluno.nome, href: '/professor/aluno/' + aluno.usuario_id }, { texto: 'FAC' }] }) %>
        <%- include('partials/flash') %>
        <div class="page-head"><div><h1>FAC · Avaliação do supervisor</h1><p><%= aluno.nome %> · <%= aluno.empresa || 'Empresa não informada' %></p></div></div>
        <% if (fac) { %>
            <div class="faa-saved"><div><strong>Avaliação salva · Média <%= fac.nota.toFixed(1).replace('.', ',') %></strong>
                <p>Atualizada em <%= dataBr(fac.atualizado_em) %></p></div>
                <a class="btn btn-secondary" href="/professor/aluno/<%= aluno.usuario_id %>/fac/pdf"><%- icone('baixar') %> Baixar PDF</a>
            </div>
        <% } %>
        <% if (rascunhoSalvo) { %><div class="aviso aviso-info" role="status">Rascunho da FAC salvo em <%= dataBr(rascunhoSalvo.atualizado_em) %>. Continue o preenchimento quando quiser.</div><% } %>
        <% if (!aluno.curso) { %><p class="aviso aviso-info">O estudante ainda não selecionou o curso em seu perfil; a FAC fica bloqueada até essa informação ser preenchida.</p><% } else if (!podeEditar) { %><p class="aviso aviso-info">Consulta da avaliação. O supervisor pode preenchê-la após o cumprimento das horas, enquanto o estágio estiver aberto e não arquivado.</p><% } %>
        <% if (erros.length) { %><div class="flash flash-error" role="alert"><ul><% erros.forEach((erro) => { %><li><%= erro %></li><% }) %></ul></div><% } %>
        <form method="POST" action="/professor/aluno/<%= aluno.usuario_id %>/fac">
            <fieldset <%= podeEditar ? '' : 'disabled' %>>
                <section class="card">
                    <h2>Dados do estágio</h2>
                    <div class="form-grid">
                        <div class="form-field"><label>Curso do estudante</label><p class="form-note"><%= aluno.curso || 'Não informado. O estudante deve selecioná-lo no perfil antes de preencher a FAC.' %></p></div>
                        <% [['empresa', 'Empresa/entidade concedente', 60, 'Ex.: Empresa XYZ Ltda.'], ['periodo', 'Período do estágio', 35, 'Ex.: 01/03/2026 a 30/09/2026']].forEach(([campo, rotulo, limite, dica]) => { %>
                            <div class="form-field"><label for="<%= campo %>"><%= rotulo %></label><input type="text" id="<%= campo %>" name="<%= campo %>" maxlength="<%= limite %>" placeholder="<%= dica %>" required value="<%= valores[campo] %>"></div>
                        <% }) %>
                    </div>
                </section>
                <section class="card"><h2>Aspectos avaliados</h2><p class="text-muted">Notas de 0 a 10. A média aritmética é calculada automaticamente, com uma casa decimal.</p>
                    <% criterios.forEach(([titulo, descricao], i) => { %>
                        <div class="faa-nota"><label for="nota_<%= i %>"><%= i + 1 %>. <%= titulo %><small class="text-muted"><%= descricao %></small></label>
                            <input type="number" id="nota_<%= i %>" name="nota_<%= i %>" min="0" max="10" step="0.01" inputmode="decimal" placeholder="0,00" required value="<%= valores.notas[i] %>"></div>
                    <% }) %>
                </section>
                <section class="card">
                    <label for="atividades">Principais atividades executadas na empresa</label><textarea id="atividades" name="atividades" maxlength="1500" rows="2" class="textarea-compacta" placeholder="Descreva as principais atividades executadas pelo estagiário." required><%= valores.atividades %></textarea>
                    <label for="comentarios">Comentários/observações</label><textarea id="comentarios" name="comentarios" maxlength="1500" rows="2" class="textarea-compacta" placeholder="Registre observações sobre o desempenho do estagiário."><%= valores.comentarios %></textarea>
                    <div class="form-grid">
                        <div class="form-field"><label for="local_assinatura">Local da assinatura</label><input type="text" id="local_assinatura" name="local_assinatura" maxlength="80" placeholder="Ex.: Videira" required value="<%= valores.local_assinatura %>"></div>
                        <div class="form-field"><label for="data_assinatura">Data da assinatura</label><input type="date" id="data_assinatura" name="data_assinatura" placeholder="DD/MM/AAAA" required value="<%= valores.data_assinatura %>"></div>
                    </div>
                    <p class="form-note">Após salvar, baixe a ficha para assinatura do supervisor e ciência do estudante e do orientador.</p>
                </section>
                <% if (podeEditar) { %>
                    <div class="button-group form-actions">
                        <button type="submit" name="acao" value="rascunho" class="btn-secondary" formnovalidate>Salvar rascunho</button>
                        <button type="submit">Salvar avaliação</button>
                    </div>
                <% } %>
            </fieldset>
        </form>
        <div class="form-actions"><a class="btn btn-secondary" href="/professor/fichas">Voltar às fichas</a></div>
    </main>
    <%- include('partials/footer') %>
</body>
</html>
