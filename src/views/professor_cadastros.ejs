<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastros Manuais</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/header') %>

    <main class="container">
        <%- include('partials/flash') %>

        <h2>Cadastros Manuais</h2>
        <p class="text-muted">O usuário poderá entrar depois usando OAuth com o mesmo e-mail informado.</p>

        <div class="grid">
            <div class="card">
                <h2>Cadastrar aluno</h2>
                <form action="/professor/cadastros" method="POST">
                    <input type="hidden" name="tipo" value="aluno">

                    <label for="aluno-nome">Nome completo</label>
                    <input type="text" id="aluno-nome" name="nome" maxlength="150" required>

                    <label for="aluno-email">E-mail</label>
                    <input type="email" id="aluno-email" name="email" maxlength="150" required>

                    <label for="aluno-matricula">Matrícula</label>
                    <input type="text" id="aluno-matricula" name="matricula" maxlength="30" required>

                    <button type="submit" class="btn-success">Cadastrar aluno</button>
                </form>
            </div>

            <div class="card">
                <h2>Cadastrar professor</h2>
                <form action="/professor/cadastros" method="POST">
                    <input type="hidden" name="tipo" value="professor">

                    <label for="professor-nome">Nome completo</label>
                    <input type="text" id="professor-nome" name="nome" maxlength="150" required>

                    <label for="professor-email">E-mail</label>
                    <input type="email" id="professor-email" name="email" maxlength="150" required>

                    <button type="submit" class="btn-success">Cadastrar professor</button>
                </form>
            </div>
        </div>

        <a href="/professor/dashboard" class="btn btn-secondary">Voltar ao dashboard</a>
    </main>

    <%- include('partials/footer') %>
</body>
</html>