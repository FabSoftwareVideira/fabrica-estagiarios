<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adicionar usuário · Controle de Estágio</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
    <%- include('partials/header') %>
    <main id="conteudo" class="container">
        <%- include('partials/flash') %>
        <div class="page-head">
            <div>
                <h1>Adicionar usuário</h1>
                <p>Cadastre uma conta escolhendo o tipo de acesso.</p>
            </div>
            <a href="/professor/usuarios" class="btn btn-secondary">Voltar para usuários</a>
        </div>

        <section class="card user-form-card">
            <form action="/professor/usuarios" method="POST" class="form-grid user-form-grid" data-admin-user-form data-user-type="aluno">
                <div class="form-field" data-user-field="nome">
                    <label for="novo-nome">Nome completo</label>
                    <input id="novo-nome" name="nome" type="text" maxlength="150" autocomplete="name" required>
                </div>
                <div class="form-field" data-user-field="email">
                    <label for="novo-email">E-mail</label>
                    <input id="novo-email" name="email" type="email" maxlength="150" autocomplete="email" required>
                    <small>O e-mail deve ser único, sem diferenciar maiúsculas de minúsculas.</small>
                </div>
                <div class="form-field" data-user-field="tipo">
                    <label for="novo-tipo">Tipo de acesso</label>
                    <select id="novo-tipo" name="tipo" required data-admin-user-type>
                        <option value="aluno">Estudante</option>
                        <option value="professor">Professor / orientador</option>
                        <option value="supervisor">Supervisor externo (aguarda aprovação)</option>
                    </select>
                </div>
                <div class="form-field" data-user-field="matricula" data-student-field>
                    <label for="nova-matricula">Matrícula <span class="text-muted">(opcional)</span></label>
                    <input id="nova-matricula" name="matricula" type="text" maxlength="30">
                </div>
                <div class="form-field" data-user-field="curso" data-student-field>
                    <label for="novo-curso">Curso</label>
                    <select id="novo-curso" name="curso" required>
                        <option value="">Selecione o curso do estudante</option>
                        <% cursos.forEach((curso) => { %><option value="<%= curso %>"><%= curso %></option><% }) %>
                    </select>
                </div>
                <div class="form-field" data-user-field="empresa" data-supervisor-field>
                    <label for="nova-empresa">Empresa/entidade</label>
                    <input id="nova-empresa" name="empresa" type="text" maxlength="200">
                </div>
                <div class="form-field" data-user-field="funcao" data-supervisor-field>
                    <label for="nova-funcao">Cargo ou função</label>
                    <input id="nova-funcao" name="funcao" type="text" maxlength="150">
                </div>
                <div class="form-field form-actions user-form-actions" data-user-field="acoes">
                    <a href="/professor/usuarios" class="btn btn-ghost">Cancelar</a>
                    <button type="submit" class="btn-success"><%- icone('mais') %> Adicionar usuário</button>
                </div>
            </form>
        </section>
    </main>
    <script>
        document.querySelectorAll('[data-admin-user-form]').forEach((form) => {
            const tipo = form.querySelector('[data-admin-user-type]');
            const atualizarCampos = () => {
                form.dataset.userType = tipo.value;
                form.querySelectorAll('[data-student-field]').forEach((campo) => {
                    campo.hidden = tipo.value !== 'aluno';
                    campo.querySelectorAll('input, select, textarea').forEach((controle) => {
                        controle.disabled = tipo.value !== 'aluno';
                    });
                });
                form.querySelectorAll('[data-supervisor-field]').forEach((campo) => {
                    campo.hidden = tipo.value !== 'supervisor';
                    campo.querySelector('input').required = tipo.value === 'supervisor';
                });
            };
            tipo.addEventListener('change', atualizarCampos);
            atualizarCampos();
        });
    </script>
    <%- include('partials/footer') %>
</body>
</html>
