<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minhas Atividades</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/header') %>

    <main class="container">
        <%- include('partials/flash') %>

        <h2>Minhas Atividades</h2>

        <div class="card">
            <div class="card-header">
                <h2>Horas</h2>
                <span class="text-muted"><%= atividades.length %> atividade(s) registrada(s)</span>
            </div>

            <p>Você tem <strong><%= horasRealizadas %>h validadas</strong> de <strong><%= cargaHoraria %>h</strong>
                (<%= percentual %>%).</p>
            <div class="progress">
                <div class="progress-bar" data-percent="<%= percentual %>"></div>
            </div>
            <p class="progress-caption text-muted">Restam <%= horasRestantes %>h</p>
            <% if (horasPendentes > 0) { %>
                <p class="progress-caption text-muted">
                    <strong><%= horasPendentes %>h</strong> aguardando validação do professor.
                </p>
            <% } %>
        </div>

        <div class="card">
            <h2>Histórico de Atividades</h2>

            <%
                const atividadesInvalidadas = atividades.filter((a) => a.status_validacao === 'invalidada');
            %>
            <% if (atividadesInvalidadas.length > 0) { %>
                <p class="text-muted">
                    Você tem <strong><%= atividadesInvalidadas.length %></strong> atividade(s) invalidada(s).
                    Essas horas não contam para a conclusão.
                    <% if (status === 'em_andamento') { %>
                        Registre uma nova atividade para substituí-las.
                    <% } %>
                </p>
            <% } %>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th>Data</th><th>Descrição</th><th>Horas</th><th>Validação</th></tr>
                    </thead>
                    <tbody>
                        <% if (atividades.length === 0) { %>
                            <tr><td colspan="4">Nenhuma atividade registrada ainda.</td></tr>
                        <% } else { %>
                            <% atividades.forEach((a) => { %>
                                <tr>
                                    <td><%= new Date(a.data).toLocaleDateString('pt-BR') %></td>
                                    <td><%= a.descricao %></td>
                                    <td><%= a.horas %>h</td>
                                    <td>
                                        <%- include('partials/status_atividade', { atividade: a }) %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="card-actions">
                <% if (status === 'em_andamento') { %>
                    <a href="/aluno/nova-atividade" class="btn">Nova Atividade</a>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
