<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhes do Aluno</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

    <%- include('partials/header') %>

    <main id="conteudo" class="container">
        <%- include('partials/breadcrumb', { itens: [
            { texto: 'Alunos', href: '/professor/dashboard' },
            { texto: aluno.nome }
        ] }) %>
        <%- include('partials/flash') %>

        <%
            const st = estagioStatus(aluno);
            const cargaHoraria = Number(aluno.carga_horaria) || 0;
            const horasRealizadas = Number(aluno.horas_realizadas) || 0;
            const horasPendentes = Number(aluno.horas_pendentes) || 0;
            const horasRestantes = Math.max(0, cargaHoraria - horasRealizadas);
            const percentual = cargaHoraria > 0
                ? Math.min(100, Math.round((horasRealizadas / cargaHoraria) * 100))
                : 0;
            const totalAtividades = atividades.length;
        %>

        <section class="card student-summary">
            <div class="student-summary-head">
                <div class="student-identity">
                    <h2><%= aluno.nome %></h2>
                    <p class="student-meta">
                        <% if (aluno.matricula) { %>
                            <span>Matrícula: <%= aluno.matricula %></span>
                        <% } %>
                        <span><%= aluno.email %></span>
                    </p>
                </div>
                <div class="student-badges">
                    <span class="status <%= st.classe %>"><%= st.label %></span>
                    <% if (aluno.arquivado) { %>
                        <span class="status status-archived">Arquivado</span>
                    <% } %>
                </div>
            </div>

            <div class="summary-progress">
                <div class="summary-progress-label">
                    <span><strong><%= horasRealizadas %>h</strong> validadas de <strong><%= cargaHoraria %>h</strong></span>
                    <span><%= percentual %>%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar" data-percent="<%= percentual %>"></div>
                </div>
                <p class="progress-caption text-muted">
                    Restam <%= horasRestantes %>h
                    <% if (horasPendentes > 0) { %>
                        · <strong><%= horasPendentes %>h</strong> aguardando validação
                    <% } %>
                </p>
            </div>

            <dl class="summary-details">
                <div>
                    <dt>Supervisor</dt>
                    <dd><%= aluno.supervisor_nome || '—' %></dd>
                </div>
                <div>
                    <dt>Orientador</dt>
                    <dd><%= aluno.orientador_nome || '—' %></dd>
                </div>
            </dl>

        </section>

        <% if (encerrado) { %>
            <div class="aviso aviso-ok" role="status">
                <%- icone('check') %>
                <div>
                    <strong>Estágio encerrado em <%= dataBr(aluno.encerrado_em) %></strong>
                    O aluno só consegue consultar e imprimir. Validações e dados do estágio estão bloqueados.
                    <% if (ehOrientador || user.cargo === 'admin') { %>
                        <form action="/professor/aluno/<%= aluno.usuario_id %>/fare/reabrir" method="POST" style="margin-top: 10px;"
                            onsubmit="return confirm('Reabrir o estágio? O aluno poderá editar a FAA de novo e a ata voltará a ser rascunho.');">
                            <button type="submit" class="btn-secondary btn-sm"><%- icone('refazer') %> Reabrir estágio</button>
                        </form>
                    <% } %>
                </div>
            </div>
        <% } %>

        <% if (aluno.status !== 'lista_espera') { %>
            <section class="card" aria-labelledby="titulo-docs">
                <h2 id="titulo-docs">Documentos</h2>
                <ul class="docs-lista">
                    <% if (aluno.status === 'concluido') { %>
                        <li><span class="doc-nome">Agendamento da banca<small>Data, sala e participantes</small></span><a href="/professor/aluno/<%= aluno.usuario_id %>/banca" class="btn btn-secondary btn-sm"><%- icone('calendario') %> Consultar / agendar</a></li>
                    <% } %>
                    <li>
                        <span class="doc-nome">Ficha de acompanhamento<small>Atividades validadas e horas</small></span>
                        <a href="/professor/aluno/<%= aluno.usuario_id %>/ficha-acompanhamento" class="btn btn-secondary btn-sm"><%- icone('baixar') %> PDF</a>
                    </li>
                    <li>
                        <span class="doc-nome">FAA · Autoavaliação<small><%= faa ? 'Preenchida pelo aluno' : 'Ainda não preenchida' %></small></span>
                        <% if (faa) { %><a href="/professor/aluno/<%= aluno.usuario_id %>/faa/pdf" class="btn btn-secondary btn-sm"><%- icone('baixar') %> PDF</a><% } %>
                    </li>
                    <% if (ehSupervisor || ehOrientador || user.cargo === 'admin') { %>
                        <li>
                            <span class="doc-nome">FAC · Avaliação do supervisor<small><%= fac ? 'Média ' + fac.nota.toFixed(1).replace('.', ',') : 'Ainda não preenchida' %></small></span>
                            <span class="table-actions">
                                <% if (fac || (ehSupervisor && aluno.status === 'concluido' && !encerrado && !aluno.arquivado)) { %><a href="/professor/aluno/<%= aluno.usuario_id %>/fac" class="btn btn-secondary btn-sm"><%= ehSupervisor && !encerrado && !aluno.arquivado ? 'Preencher/editar' : 'Consultar' %></a><% } %>
                                <% if (fac) { %><a href="/professor/aluno/<%= aluno.usuario_id %>/fac/pdf" class="btn btn-secondary btn-sm"><%- icone('baixar') %> PDF</a><% } %>
                            </span>
                        </li>
                    <% } %>
                    <% if (aluno.status === 'concluido') { %>
                        <li>
                            <span class="doc-nome">FAPO · Avaliação do orientador<small><%= fapo ? 'Nota ' + String(fapo.nota).replace('.', ',') : 'Ainda não preenchida' %></small></span>
                            <span class="table-actions">
                                <% if (podeGerarFapo) { %><a href="/professor/aluno/<%= aluno.usuario_id %>/fapo" class="btn btn-success btn-sm"><%- icone('caneta') %> <%= fapo ? 'Editar' : 'Preencher' %></a><% } %>
                                <% if (fapo && ehOrientador) { %><a href="/professor/aluno/<%= aluno.usuario_id %>/fapo/pdf" class="btn btn-secondary btn-sm"><%- icone('baixar') %> PDF</a><% } %>
                            </span>
                        </li>
                        <li>
                            <span class="doc-nome">Ata da banca<small><%= encerrado ? 'Estágio encerrado' : (fare ? 'Rascunho salvo' : 'Ainda não preenchida') %></small></span>
                            <span class="table-actions">
                                <% if (ehOrientador) { %><a href="/professor/aluno/<%= aluno.usuario_id %>/fare" class="btn <%= encerrado ? 'btn-secondary' : 'btn-success' %> btn-sm"><%- icone('caneta') %> <%= encerrado ? 'Ver' : (fare ? 'Continuar' : 'Preencher') %></a><% } %>
                                <% if (fare && ehOrientador) { %><a href="/professor/aluno/<%= aluno.usuario_id %>/fare/pdf" class="btn btn-secondary btn-sm"><%- icone('baixar') %> PDF</a><% } %>
                            </span>
                        </li>
                    <% } %>
                </ul>
                <% if (aluno.status === 'concluido' && !ehOrientador) { %>
                    <p class="text-muted" style="margin-top: 10px;">A FAPO e a ata da banca são preenchidas pelo orientador do aluno.</p>
                <% } %>
            </section>
        <% } %>

        <% if (encerrado) { %>
        <% } else if (aluno.arquivado) { %>
            <div class="card archived-banner">
                <div>
                    <h2>Estágio arquivado</h2>
                    <p class="text-muted">
                        A validação de horas está bloqueada enquanto o estágio estiver arquivado.
                        Desarquive para voltar a editar e validar atividades.
                    </p>
                </div>
                <div class="button-group">
                    <form action="/professor/aluno/<%= aluno.usuario_id %>/desarquivar" method="POST">
                        <button type="submit">Desarquivar</button>
                    </form>
                    <a href="/professor/arquivados" class="btn btn-secondary">Voltar</a>
                </div>
            </div>
        <% } else { %>
            <details class="card details-card">
                <summary>
                    <span class="details-title">
                        <strong>Editar estágio</strong>
                        <small>Status, supervisor, orientador e carga horária</small>
                    </span>
                    <span class="details-toggle" aria-hidden="true">+</span>
                </summary>

                <form action="/professor/aluno/<%= aluno.usuario_id %>" method="POST" class="details-body">
                    <% if (aluno.status === 'concluido') { %>
                        <label>Status do Estágio</label>
                        <p><span class="status status-completed">Concluído</span></p>
                        <p class="text-muted">
                            A conclusão é automática. Remova a validação de alguma atividade para que o
                            aluno volte para "Em andamento".
                        </p>
                        <input type="hidden" name="status" value="em_andamento">
                    <% } else { %>
                        <label for="status">Status do Estágio</label>
                        <select id="status" name="status">
                            <option value="lista_espera" <%= aluno.status === 'lista_espera' ? 'selected' : '' %>>Lista de Espera</option>
                            <option value="em_andamento" <%= aluno.status === 'em_andamento' ? 'selected' : '' %>>Em Andamento</option>
                        </select>
                        <p class="text-muted">
                            O status "Concluído" é definido automaticamente quando as horas validadas
                            atingem a carga horária.
                        </p>
                    <% } %>

                    <label for="supervisor">Supervisor</label>
                    <select id="supervisor" name="supervisor_id">
                        <option value="">Selecione um professor</option>
                        <% professores.forEach((p) => { %>
                            <option value="<%= p.id %>" <%= aluno.supervisor_id === p.id ? 'selected' : '' %>><%= p.nome %></option>
                        <% }) %>
                    </select>

                    <label for="orientador">Orientador</label>
                    <select id="orientador" name="orientador_id">
                        <option value="">Selecione um professor</option>
                        <% professores.forEach((p) => { %>
                            <option value="<%= p.id %>" <%= aluno.orientador_id === p.id ? 'selected' : '' %>><%= p.nome %></option>
                        <% }) %>
                    </select>

                    <label for="empresa">Empresa/Entidade concedente</label>
                    <input type="text" id="empresa" name="empresa" required value="<%= aluno.empresa || '' %>" placeholder="Nome da empresa ou entidade">

                    <label for="carga">Carga Horária Total</label>
                    <input type="number" id="carga" name="carga_horaria" min="1" value="<%= aluno.carga_horaria %>">

                    <div class="button-group form-actions">
                        <button type="submit">Salvar Alterações</button>
                        <button type="submit" formaction="/professor/aluno/<%= aluno.usuario_id %>/arquivar" formnovalidate class="btn-secondary">Arquivar</button>
                    </div>
                </form>
            </details>
        <% } %>

        <div class="card">
            <div class="card-header">
                <div>
                    <h2>Atividades</h2>
                    <p class="text-muted">
                        <%= totalAtividades %> atividade(s)
                        <% if (horasPendentes > 0) { %> · <%= horasPendentes %>h pendentes de validação<% } %>
                    </p>
                </div>
            </div>

            <p class="text-muted">
                A validação das horas é responsabilidade do supervisor atribuído ao estágio.
                Ao invalidar uma atividade, as horas deixam de contar e o aluno precisará registrar outra.
                <% if (!aluno.arquivado && !podeValidarAtividades) { %>
                    Você pode consultar as atividades, mas somente o supervisor pode validá-las ou invalidá-las.
                <% } %>
            </p>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Horário</th>
                            <th>Descrição</th>
                            <th>Horas</th>
                            <th>Validação</th>
                            <% if (podeValidarAtividades) { %><th>Ações</th><% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (atividades.length === 0) { %>
                            <tr>
                                <td colspan="<%= podeValidarAtividades ? 6 : 5 %>">Nenhuma atividade registrada ainda.</td>
                            </tr>
                        <% } else { %>
                            <% atividades.forEach((a) => { %>
                                <tr>
                                    <td><%= new Date(a.data).toLocaleDateString('pt-BR') %></td>
                                    <td>
                                        <% if (a.hora_inicio && a.hora_fim) { %>
                                            <span class="atividade-horario">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <polyline points="12 6 12 12 16 14"></polyline>
                                                </svg>
                                                <%= a.hora_inicio.slice(0, 5) %> – <%= a.hora_fim.slice(0, 5) %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-muted">—</span>
                                        <% } %>
                                    </td>
                                    <td><%= a.descricao %></td>
                                    <td><%= a.horas %>h</td>
                                    <td>
                                        <%- include('partials/status_atividade', { atividade: a }) %>
                                    </td>
                                    <% if (podeValidarAtividades) { %>
                                        <td>
                                            <% if (a.status_validacao === 'invalidada') { %>
                                                <form
                                                    action="/professor/aluno/<%= aluno.usuario_id %>/atividade/<%= a.id %>/validar"
                                                    method="POST">
                                                    <button type="submit" class="btn-success btn-icon" title="Validar novamente" aria-label="Validar novamente">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                            <polyline points="20 6 9 17 4 12"></polyline>
                                                        </svg>
                                                    </button>
                                                </form>
                                            <% } else if (a.status_validacao === 'validada') { %>
                                                <form action="/professor/aluno/<%= aluno.usuario_id %>/atividade/<%= a.id %>/invalidar"
                                                    method="POST">
                                                    <button type="submit" class="btn-danger btn-icon" title="Invalidar (desfazer validação)" aria-label="Invalidar">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                                        </svg>
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <div class="table-actions">
                                                    <form action="/professor/aluno/<%= aluno.usuario_id %>/atividade/<%= a.id %>/validar"
                                                        method="POST">
                                                        <button type="submit" class="btn-success btn-icon" title="Aprovar horas" aria-label="Aprovar horas">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                                <polyline points="20 6 9 17 4 12"></polyline>
                                                            </svg>
                                                        </button>
                                                    </form>
                                                    <form action="/professor/aluno/<%= aluno.usuario_id %>/atividade/<%= a.id %>/invalidar"
                                                        method="POST">
                                                        <button type="submit" class="btn-danger btn-icon" title="Não aprovar horas" aria-label="Não aprovar horas">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                                            </svg>
                                                        </button>
                                                    </form>
                                                </div>
                                            <% } %>
                                        </td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
