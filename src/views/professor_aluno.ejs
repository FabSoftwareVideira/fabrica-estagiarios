<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhes do Aluno</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/header') %>

    <main class="container">
        <%- include('partials/flash') %>

        <h2>Detalhes do Aluno</h2>

        <% const statusLabel = { lista_espera: 'Lista de Espera', em_andamento: 'Em andamento', concluido: 'Concluído' }; %>
        <% const statusClass = { lista_espera: 'status-waiting', em_andamento: 'status-progress', concluido: 'status-completed' }; %>

        <div class="grid">
            <div class="info-box">
                <h3>Status</h3>
                <span class="status <%= statusClass[aluno.status] %>"><%= statusLabel[aluno.status] %></span>
            </div>
            <div class="info-box"><h3>Horas Realizadas</h3><p><%= aluno.horas_realizadas %>h</p></div>
            <div class="info-box"><h3>Carga Horária</h3><p><%= aluno.carga_horaria %>h</p></div>
        </div>

        <div class="card">
            <h2>Informações Pessoais</h2>
            <table>
                <tr><th>Campo</th><th>Informação</th></tr>
                <tr><td>Nome</td><td><%= aluno.nome %></td></tr>
                <tr><td>E-mail</td><td><%= aluno.email %></td></tr>
                <tr><td>Matrícula</td><td><%= aluno.matricula %></td></tr>
            </table>
        </div>

        <% if (aluno.arquivado) { %>
            <div class="card">
                <h2>Estágio Arquivado</h2>
                <p class="text-muted">
                    Este aluno está arquivado — as informações abaixo são somente leitura.
                    Desarquive para poder editar o estágio.
                </p>
                <br>
                <table>
                    <tr><th>Campo</th><th>Informação</th></tr>
                    <tr><td>Supervisor</td><td><%= aluno.supervisor_nome || '—' %></td></tr>
                    <tr><td>Orientador</td><td><%= aluno.orientador_nome || '—' %></td></tr>
                    <tr><td>Carga Horária</td><td><%= aluno.carga_horaria %>h</td></tr>
                </table>
                <br>
                <div class="button-group">
                    <form action="/professor/aluno/<%= aluno.usuario_id %>/desarquivar" method="POST">
                        <button type="submit">Desarquivar</button>
                    </form>
                    <a href="/professor/arquivados" class="btn btn-secondary">Voltar</a>
                </div>
            </div>
        <% } else { %>
        <div class="card">
            <h2>Editar Estágio</h2>
            <form action="/professor/aluno/<%= aluno.usuario_id %>" method="POST">
                <label for="status">Status do Estágio</label>
                <select id="status" name="status">
                    <option value="lista_espera" <%= aluno.status === 'lista_espera' ? 'selected' : '' %>>Lista de Espera</option>
                    <option value="em_andamento" <%= aluno.status === 'em_andamento' ? 'selected' : '' %>>Em Andamento</option>
                    <option value="concluido" <%= aluno.status === 'concluido' ? 'selected' : '' %>>Concluído</option>
                </select>

                <label for="supervisor">Supervisor</label>
                <select id="supervisor" name="supervisor_id">
                    <option value="">Selecione um professor</option>
                    <% professores.forEach((p) => { %>
                        <option value="<%= p.id %>" <%= aluno.supervisor_id === p.id ? 'selected' : '' %>><%= p.nome %></option>
                    <% }) %>
                </select>

                <label for="orientador">Orientador</label>
                <select id="orientador" name="orientador_id">
                    <option value="">Selecione um professor</option>
                    <% professores.forEach((p) => { %>
                        <option value="<%= p.id %>" <%= aluno.orientador_id === p.id ? 'selected' : '' %>><%= p.nome %></option>
                    <% }) %>
                </select>

                <label for="carga">Carga Horária Total</label>
                <input type="number" id="carga" name="carga_horaria" min="1" value="<%= aluno.carga_horaria %>">

                <div class="button-group">
                    <button type="submit">Salvar Alterações</button>
                    <% if (aluno.status !== 'concluido') { %>
                        <button type="submit" formaction="/professor/aluno/<%= aluno.usuario_id %>/arquivar" formnovalidate class="btn-secondary">Arquivar</button>
                    <% } %>
                    <a href="/professor/dashboard" class="btn btn-secondary">Voltar</a>
                </div>
            </form>
        </div>
        <% } %>

        <div class="card">
            <h2>Histórico de Atividades</h2>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Data</th><th>Descrição</th><th>Horas</th></tr></thead>
                    <tbody>
                        <% if (atividades.length === 0) { %>
                            <tr><td>—</td><td>Nenhuma atividade registrada ainda.</td><td>—</td></tr>
                        <% } else { %>
                            <% atividades.forEach((a) => { %>
                                <tr>
                                    <td><%= new Date(a.data).toLocaleDateString('pt-BR') %></td>
                                    <td><%= a.descricao %></td>
                                    <td><%= a.horas %>h</td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
