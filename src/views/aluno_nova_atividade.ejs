<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova atividade · Controle de Estágio</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

    <%- include('partials/header') %>

    <main id="conteudo" class="container">
        <%- include('partials/breadcrumb', { itens: [
            { texto: 'Início', href: '/aluno/dashboard' },
            { texto: 'Atividades', href: '/aluno/dashboard?aba=atividades' },
            { texto: modoEdicao ? 'Editar atividade' : 'Nova atividade' }
        ] }) %>
        <%- include('partials/flash') %>

        <div class="page-head">
            <div>
                <h1><%= modoEdicao ? 'Editar atividade' : 'Registrar atividade' %></h1>
                <p><%= modoEdicao
                    ? 'Atualize a data, o horário e a descrição do que você realizou.'
                    : 'Escolha o dia no calendário e conte o que você fez. O registro é permitido de segunda a sábado, mesmo fora da escala planejada.' %></p>
            </div>
        </div>

        <div class="atividade-layout">
            <section class="card" aria-labelledby="titulo-calendario">
                <h2 id="titulo-calendario" class="sr-only">Calendário</h2>
                <%- include('partials/calendario', {
                    dados: calendario,
                    modo: 'selecionar',
                    hoje,
                    selecionado: formData.data || '',
                    horariosTrabalho
                }) %>
                <div class="dia-resumo" data-cal-painel aria-live="polite" hidden></div>
            </section>

            <section class="card">
                <h2>Dados da atividade</h2>
                <% if (modoEdicao && formData.status_validacao && formData.status_validacao !== 'pendente') { %>
                    <p class="aviso aviso-info">Ao salvar, esta atividade voltará para <strong>pendente</strong> e precisará ser avaliada pelo supervisor novamente.</p>
                <% } else if (modoEdicao) { %>
                    <p class="text-muted">Depois de salvar, a atividade permanecerá pendente até ser avaliada pelo supervisor.</p>
                <% } %>
                <% if (Object.keys(horariosTrabalho).length > 0) { %>
                    <p class="aviso aviso-info">
                        <strong>Sua escala planejada:</strong>
                        <%= diasTrabalho.filter((dia) => horariosTrabalho[String(dia.id)])
                            .map((dia) => `${dia.nome}, ${horariosTrabalho[String(dia.id)].inicio}–${horariosTrabalho[String(dia.id)].fim}`)
                            .join(' · ') %>.
                        Você pode registrar em qualquer dia de segunda a sábado, até 6 horas no total por dia.
                    </p>
                <% } else { %>
                    <p class="text-muted">A escala de trabalho ainda não foi informada. Você pode registrar em qualquer dia de segunda a sábado, até 6 horas no total por dia.</p>
                <% } %>
                <form action="<%= modoEdicao ? `/aluno/atividade/${atividadeId}/editar` : '/aluno/nova-atividade' %>" method="POST">
                    <label for="data">Dia</label>
                    <input type="date" id="data" name="data" required value="<%= formData.data || '' %>">

                    <div class="form-grid form-grid-2">
                        <div class="form-field">
                            <label for="hora_inicio">Entrada</label>
                            <input type="time" id="hora_inicio" name="hora_inicio" required value="<%= formData.hora_inicio || '' %>">
                        </div>
                        <div class="form-field">
                            <label for="hora_fim">Saída</label>
                            <input type="time" id="hora_fim" name="hora_fim" required value="<%= formData.hora_fim || '' %>">
                        </div>
                    </div>

                    <label for="horas">Duração</label>
                    <input type="number" id="horas" name="horas" min="0.01" max="6" step="0.01" placeholder="Calculada pelos horários" readonly>
                    <small class="text-muted">Calculada sozinha a partir da entrada e da saída.</small>

                    <label for="descricao">O que você fez?</label>
                    <input type="text" id="descricao" name="descricao" maxlength="140" placeholder="Descreva de forma objetiva a atividade realizada" required value="<%= formData.descricao || '' %>">
                    <small id="descricao-contador" class="text-muted" aria-live="polite">0/140 caracteres</small>

                    <div class="form-note">
                        <strong>Antes de salvar</strong>
                        <ul>
                            <li>Registre só o que você realmente fez.</li>
                            <li>Domingos não aceitam registro. Cada dia, inclusive sábado, vai até 6 horas.</li>
                            <li>As horas só entram no total depois que o supervisor validar.</li>
                        </ul>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-success"><%- icone('check') %> <%= modoEdicao ? 'Salvar alterações' : 'Salvar atividade' %></button>
                        <a href="/aluno/dashboard?aba=atividades" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </section>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
