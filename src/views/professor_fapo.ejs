<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ficha de Avaliação do Orientador (FAPO)</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

    <%- include('partials/header') %>

    <main id="conteudo" class="container">
        <%- include('partials/breadcrumb', { itens: [
            { texto: 'Fichas', href: '/professor/fichas' },
            { texto: aluno.nome, href: '/professor/aluno/' + aluno.usuario_id },
            { texto: 'FAPO' }
        ] }) %>
        <%- include('partials/flash') %>

        <div class="page-head">
            <div>
                <h1>FAPO · Avaliação do orientador</h1>
                <p><strong><%= aluno.nome %></strong> · <%= aluno.empresa || 'Empresa não informada' %></p>
            </div>
        </div>

        <% if (fapoSalva) { %>
            <div class="faa-saved">
                <div>
                    <strong>FAPO salva.</strong>
                    <span class="text-muted">
                        Última atualização em <%= new Date(fapoSalva.atualizado_em).toLocaleString('pt-BR') %>.
                    </span>
                </div>
                <a href="/professor/aluno/<%= aluno.usuario_id %>/fapo/pdf" class="btn btn-secondary"><%- icone('baixar') %> Baixar PDF</a>
            </div>
        <% } %>

        <form action="/professor/aluno/<%= aluno.usuario_id %>/fapo" method="POST">
            <section class="card">
                <div class="form-grid">
                    <div class="form-field">
                        <label for="nota">Nota do estágio (0 a 10)</label>
                        <input type="number" id="nota" name="nota" min="0" max="10" step="0.1" required
                            value="<%= nota %>" placeholder="Ex.: 9,5">
                    </div>

                    <div class="form-field">
                        <label for="data_assinatura">Data da assinatura</label>
                        <input type="date" id="data_assinatura" name="data_assinatura" required value="<%= dataAssinatura %>">
                    </div>
                </div>

                <label for="comentarios">Comentários/observações</label>
                <textarea id="comentarios" name="comentarios"
                    placeholder="Opcional"><%= comentarios %></textarea>
            </section>

            <div class="button-group form-actions">
                <button type="submit" name="acao" value="salvar_pdf" class="btn-success">Salvar e baixar PDF</button>
                <button type="submit" name="acao" value="salvar" class="btn-secondary">Salvar sem baixar</button>
                <a href="/professor/fichas" class="btn btn-secondary">Voltar às fichas</a>
            </div>
        </form>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
