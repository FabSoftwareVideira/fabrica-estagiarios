<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ficha de Avaliação do Orientador (FAPO)</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/header') %>

    <main class="container">
        <%- include('partials/flash') %>

        <h2>Ficha de Avaliação pelo Professor Orientador (FAPO)</h2>
        <p class="text-muted page-subtitle">
            Estagiário(a): <strong><%= aluno.nome %></strong> ·
            Empresa/Entidade concedente: <strong><%= aluno.empresa || '—' %></strong>
        </p>

        <% if (fapoSalva) { %>
            <div class="faa-saved">
                <div>
                    <strong>FAPO salva.</strong>
                    <span class="text-muted">
                        Última atualização em <%= new Date(fapoSalva.atualizado_em).toLocaleString('pt-BR') %>.
                    </span>
                </div>
                <a href="/professor/aluno/<%= aluno.usuario_id %>/fapo/pdf" class="btn btn-secondary">Gerar PDF novamente</a>
            </div>
        <% } %>

        <form action="/professor/aluno/<%= aluno.usuario_id %>/fapo" method="POST">
            <section class="card">
                <div class="form-grid">
                    <div class="form-field">
                        <label for="nota">Nota do estágio (0 a 10)</label>
                        <input type="number" id="nota" name="nota" min="0" max="10" step="0.1" required
                            value="<%= nota %>" placeholder="Ex.: 9,5">
                    </div>

                    <div class="form-field">
                        <label for="data_assinatura">Data da assinatura</label>
                        <input type="date" id="data_assinatura" name="data_assinatura" required value="<%= dataAssinatura %>">
                    </div>
                </div>

                <label for="comentarios">Comentários/observações</label>
                <textarea id="comentarios" name="comentarios"
                    placeholder="Opcional"><%= comentarios %></textarea>
            </section>

            <div class="button-group form-actions">
                <button type="submit" name="acao" value="salvar_pdf">Salvar e gerar PDF da FAPO</button>
                <button type="submit" name="acao" value="salvar" class="btn-secondary">Salvar sem gerar PDF</button>
                <a href="/professor/aluno/<%= aluno.usuario_id %>" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
