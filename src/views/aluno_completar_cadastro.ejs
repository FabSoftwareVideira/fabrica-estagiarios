<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Completar Cadastro</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

    <%- include('partials/header') %>

    <main id="conteudo" class="container">
        <%- include('partials/flash') %>

        <div class="login-box">
            <h1>Falta pouco!</h1>
            <p>Confirme seu nome, matrícula e curso, e escolha um personagem para concluir o cadastro.</p>

            <form action="/aluno/completar-cadastro" method="POST">
                <label for="nome">Nome completo</label>
                <input type="text" id="nome" name="nome" maxlength="150" value="<%= nomeAtual %>" required>
                <label for="matricula">Matrícula</label>
                <input type="text" id="matricula" name="matricula" required>
                <label for="curso">Curso</label>
                <select id="curso" name="curso" required>
                    <option value="">Selecione seu curso</option>
                    <% cursos.forEach((curso) => { %><option value="<%= curso %>"><%= curso %></option><% }) %>
                </select>
                <%- include('partials/avatar-picker', { avatares, selectedAvatar }) %>
                <button type="submit" class="btn">Concluir Cadastro</button>
            </form>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
