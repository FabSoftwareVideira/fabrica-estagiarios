<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.cargo === 'supervisor' ? 'Supervisionados' : 'Estagiários' %> · Controle de Estágio</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>

<body>
    <% const supervisor = user.cargo === 'supervisor'; %>
    <%- include('partials/header') %>

    <main id="conteudo" class="container">
        <%- include('partials/flash') %>
        <%- include('partials/breadcrumb', { itens: [{ texto: supervisor ? 'Supervisionados' : 'Estagiários' }] }) %>

        <% if (solicitacoesPendentes > 0) { %>
            <section class="card pending-requests-banner" aria-label="Solicitações de supervisores externos">
                <div>
                    <strong><%- icone('alerta') %> <%= solicitacoesPendentes %> <%= solicitacoesPendentes === 1 ? 'solicitação aguarda' : 'solicitações aguardam' %> aprovação</strong>
                    <p>Supervisores externos são aprovados pelo administrador ou pelo setor de estágios.</p>
                </div>
                <a href="/professor/usuarios" class="btn btn-secondary btn-sm">Revisar solicitações</a>
            </section>
        <% } %>

        <% if (supervisor && typeof facPendentes !== 'undefined' && facPendentes.length) { %>
            <%- include('partials/painel/fac_pendentes', { facPendentes }) %>
        <% } %>

        <%- include('partials/painel/filtros') %>

        <% if (typeof minhasBancas !== 'undefined' && minhasBancas.length) { %>
            <%- include('partials/painel/bancas_resumo', { minhasBancas }) %>
        <% } %>

        <div class="card">
            <% if (supervisor) { %>
                <% if (alunos.length === 0) { %>
                    <p class="empty-state">Nenhum supervisionado encontrado com os filtros atuais.</p>
                <% } else { %>
                    <div class="supervisionados-grid">
                        <% alunos.forEach((a) => { %><%- include('partials/painel/supervisionado_card', { a }) %><% }) %>
                    </div>
                <% } %>
            <% } else { %>
                <%- include('partials/painel/tabela_estagiarios') %>
            <% } %>

            <%- include('partials/paginacao', {
                pagina, totalPaginas, total,
                inicio: total === 0 ? 0 : (pagina - 1) * tamanhoPagina + 1,
                fim: Math.min(total, pagina * tamanhoPagina),
                rotulo: supervisor ? 'supervisionado(s)' : 'estagiário(s)',
                ariaLabel: 'Paginação da lista',
                url: links.pagina,
            }) %>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
