<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aprovar cadastro de estagiário</title>
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

    <%- include('partials/header') %>

    <main id="conteudo" class="container">
        <%- include('partials/flash') %>
        <%- include('partials/breadcrumb', { itens: [listaAlunosNav(user), { texto: 'Aprovar cadastro de ' + aluno.nome }] }) %>

        <div class="page-head">
            <div>
                <h1>Aprovar cadastro</h1>
                <p><%= aluno.nome %> · primeira aprovação do estágio. Depois de aprovado, os dados podem ser alterados na tela do estudante.</p>
            </div>
        </div>

        <form action="/professor/cadastro-aluno/<%= aluno.usuario_id %>" method="POST" class="card wizard" data-wizard>
            <ol class="wizard-etapas" data-wizard-etapas hidden></ol>
            <p class="wizard-erro flash flash-error" data-wizard-erro role="alert" hidden></p>

            <section class="form-secao" data-passo data-titulo="Estudante">
                <h2>Confira os dados do estudante</h2>
                <p class="text-muted">Estes dados foram informados pelo estudante no cadastro. Se algo estiver errado, peça para ele corrigir no perfil antes de aprovar.</p>
                <div class="student-summary-head wizard-estudante">
                    <div class="student-identity">
                        <h3><%= aluno.nome %></h3>
                        <p class="student-meta"><span><%= aluno.email %></span></p>
                    </div>
                    <div class="student-badges">
                        <span class="status status-waiting">Lista de espera</span>
                    </div>
                </div>
                <dl class="summary-details">
                    <div><dt>Curso</dt><dd><%= aluno.curso || 'Não informado' %></dd></div>
                    <div><dt>Matrícula</dt><dd><%= aluno.matricula || 'Não informada' %></dd></div>
                </dl>
            </section>

            <section class="form-secao" data-passo data-titulo="Orientador">
                <h2>Quem será o professor orientador?</h2>
                <p class="text-muted">O orientador acompanha o estágio e preenche a FAPO e a ata da banca.</p>
                <div class="form-field wizard-campo">
                    <label for="orientador">Professor orientador</label>
                    <select id="orientador" name="orientador_id" required data-resumo="Orientador">
                        <option value="">Selecione um professor</option>
                        <% professores.forEach((p) => { %>
                            <option value="<%= p.id %>" <%= Number(p.id) === Number(user.id) ? 'selected' : '' %>><%= p.nome %></option>
                        <% }) %>
                    </select>
                </div>
            </section>

            <section class="form-secao" data-passo data-titulo="Supervisor">
                <h2>Quem será o supervisor?</h2>
                <p class="text-muted">O supervisor valida as atividades na empresa. Se ainda não souber, deixe em branco e defina depois na tela do estudante.</p>
                <div class="form-field wizard-campo">
                    <label for="supervisor">Supervisor <span class="text-muted">(opcional)</span></label>
                    <select id="supervisor" name="supervisor_id" data-resumo="Supervisor" data-resumo-vazio="Definir depois">
                        <option value="">Definir depois</option>
                        <% if (supervisores.length) { %>
                            <optgroup label="Supervisores externos">
                                <% supervisores.forEach((p) => { %>
                                    <option value="<%= p.id %>"><%= p.nome %></option>
                                <% }) %>
                            </optgroup>
                        <% } %>
                        <optgroup label="Professores e servidores">
                            <% (typeof supervisoresInternos !== 'undefined' ? supervisoresInternos : professores).forEach((p) => { %>
                                <option value="<%= p.id %>"><%= p.nome %></option>
                            <% }) %>
                        </optgroup>
                    </select>
                    <small>Não pode ser a mesma pessoa que o orientador.</small>
                </div>
            </section>

            <section class="form-secao" data-passo data-titulo="Estágio">
                <h2>Onde e por quanto tempo?</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label for="empresa">Empresa/Entidade concedente</label>
                        <input type="text" id="empresa" name="empresa" required value="<%= aluno.empresa || '' %>" placeholder="Nome da empresa ou entidade" data-resumo="Empresa">
                    </div>
                    <div class="form-field">
                        <label for="carga">Carga horária total <span class="text-muted">(horas)</span></label>
                        <input type="number" id="carga" name="carga_horaria" min="1" placeholder="Ex.: 60" value="60" required data-resumo="Carga horária" data-resumo-sufixo=" horas">
                    </div>
                </div>
            </section>

            <section class="form-secao" data-passo data-titulo="Horários" data-passo-horarios data-horarios-opcionais>
                <%- include('partials/horario-trabalho-campos', { diasTrabalho, horarioTrabalho: aluno.horario_trabalho || {}, opcional: true }) %>
            </section>

            <section class="form-secao" data-passo data-titulo="Revisão" data-passo-revisao hidden>
                <h2>Revise e aprove</h2>
                <p class="text-muted">Ao aprovar, <%= aluno.nome %> sai da lista de espera e já pode registrar atividades.</p>
                <dl class="summary-details" data-wizard-resumo></dl>
            </section>

            <div class="form-actions wizard-acoes">
                <button type="button" class="btn-secondary" data-wizard-voltar hidden><%- icone('esquerda') %> Voltar</button>
                <button type="button" data-wizard-avancar hidden>Continuar <%- icone('direita') %></button>
                <button type="submit" class="btn-success" data-wizard-enviar><%- icone('check') %> Aprovar cadastro</button>
                <a href="/professor/dashboard" class="btn btn-ghost wizard-cancelar">Cancelar</a>
            </div>
        </form>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
