<div class="table-actions">
    <a href="/professor/aluno/<%= a.usuario_id %>" class="btn btn-icon" title="Visualizar" aria-label="Visualizar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
        </svg>
    </a>

    <% if (a.arquivado) { %>
        <form action="/professor/aluno/<%= a.usuario_id %>/desarquivar" method="POST">
            <button type="submit" class="btn-secondary btn-icon" title="Desarquivar" aria-label="Desarquivar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="21 8 21 21 3 21 3 8"></polyline>
                    <rect x="1" y="3" width="22" height="5"></rect>
                    <polyline points="9 14 12 11 15 14"></polyline>
                    <line x1="12" y1="11" x2="12" y2="17"></line>
                </svg>
            </button>
        </form>

        <% if (user.cargo === 'admin') { %>
            <form action="/professor/aluno/<%= a.usuario_id %>/excluir" method="POST"
                onsubmit="return confirm('Excluir este aluno definitivamente? Essa ação não pode ser desfeita.');">
                <button type="submit" class="btn-danger btn-icon" title="Excluir" aria-label="Excluir">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                        <path d="M10 11v6"></path>
                        <path d="M14 11v6"></path>
                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                    </svg>
                </button>
            </form>
        <% } %>
    <% } else if (a.status === 'lista_espera') { %>
        <a href="/professor/cadastro-aluno/<%= a.usuario_id %>" class="btn btn-success btn-icon" title="Aprovar" aria-label="Aprovar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </a>
        <form action="/professor/aluno/<%= a.usuario_id %>/arquivar" method="POST">
            <button type="submit" class="btn-secondary btn-icon" title="Arquivar" aria-label="Arquivar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="21 8 21 21 3 21 3 8"></polyline>
                    <rect x="1" y="3" width="22" height="5"></rect>
                    <line x1="10" y1="12" x2="14" y2="12"></line>
                </svg>
            </button>
        </form>
    <% } else if (a.status === 'em_andamento') { %>
        <form action="/professor/aluno/<%= a.usuario_id %>/arquivar" method="POST">
            <button type="submit" class="btn-secondary btn-icon" title="Arquivar" aria-label="Arquivar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="21 8 21 21 3 21 3 8"></polyline>
                    <rect x="1" y="3" width="22" height="5"></rect>
                    <line x1="10" y1="12" x2="14" y2="12"></line>
                </svg>
            </button>
        </form>
    <% } %>
</div>
