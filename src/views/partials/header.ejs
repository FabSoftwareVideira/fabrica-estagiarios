<a href="#conteudo" class="skip-link">Ir para o conteúdo</a>
<% if (typeof demoMode !== 'undefined' && demoMode) { %>
<div class="demo-toolbar"><strong>Demonstração · dados fictícios</strong><a href="/demo">Trocar perfil / caixa de e-mail local</a></div>
<% } %>

<div class="utility-bar">
    <div class="utility-inner">
        <ul class="utility-links" aria-label="Acesso rápido">
            <li><a href="https://videira.ifc.edu.br/estagios-extensao/" target="_blank" rel="noopener noreferrer">Extensão e Estágios</a></li>
            <li><a href="https://sig.ifc.edu.br" target="_blank" rel="noopener noreferrer">SIGAA</a></li>
            <li><a href="https://videira.ifc.edu.br/" target="_blank" rel="noopener noreferrer">Portal do Campus</a></li>
        </ul>
        <button type="button" class="contrast-toggle" data-contraste aria-pressed="false">
            <%- icone('contraste') %> Alto contraste
        </button>
    </div>
</div>

<header class="site-header">
    <div class="header-inner">
        <a href="<%= user ? (user.cargo === 'supervisor' && !user.supervisorAprovado ? '/supervisor/pendente' : (user.tipo === 'professor' ? '/professor/inicio' : '/aluno/dashboard')) : '/' %>" class="brand">
            <img src="/img/logo-ifc-videira.png" alt="Instituto Federal Catarinense, Campus Videira" class="brand-logo" width="110" height="44">
            <span class="brand-text">Controle de Estágio<small>Cursos Técnicos Integrados ao Ensino Médio</small></span>
        </a>

        <% if (user) { %>
            <button class="nav-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-principal">
                <%- icone('menu') %> <span class="nav-toggle-text">Menu</span>
            </button>
        <% } %>

        <nav class="main-nav" id="menu-principal" aria-label="Navegação principal">
            <% if (user) { %>
                <% const ativo = (condicao) => (condicao ? 'active' : ''); %>
                <% const atual = (condicao) => (condicao ? 'aria-current="page"' : ''); %>
                <% if (!(user.cargo === 'supervisor' && !user.supervisorAprovado)) { %>
                <div class="nav-links">
                    <% if (user.tipo === 'aluno') { %>
                        <% const noDash = currentPath === '/aluno/dashboard'; %>
                        <% const aba = currentTab || 'resumo'; %>
                        <a href="/aluno/dashboard" class="nav-link <%= ativo(noDash && aba !== 'atividades' && aba !== 'fichas') %>"><%- icone('home') %> Início</a>
                        <a href="/aluno/dashboard?aba=atividades" class="nav-link <%= ativo(noDash && aba === 'atividades') %>"><%- icone('lista') %> Atividades</a>
                        <a href="/aluno/dashboard?aba=fichas" class="nav-link <%= ativo((noDash && aba === 'fichas') || currentPath.startsWith('/aluno/faa')) %>"><%- icone('arquivo') %> Fichas</a>
                    <% } else { %>
                        <% const emFichas = currentPath === '/professor/fichas' || /^\/professor\/aluno\/\d+\/(fare|fapo|fac)/.test(currentPath); %>
                        <% const emBancas = currentPath.startsWith('/professor/bancas') || /^\/professor\/aluno\/\d+\/banca/.test(currentPath); %>
                        <% const papeis = user.papeis || {}; %>
                        <% const externo = user.cargo === 'supervisor'; %>
                        <% const emAdmin = currentPath === '/professor/administracao' || currentPath.startsWith('/professor/usuarios') || ['/professor/relatorio-semanal', '/professor/professores', '/professor/cadastros'].includes(currentPath); %>
                        <% const emAcompanhamento = currentPath === '/professor/acompanhamento'; %>
                        <% const emInclusao = currentPath.startsWith('/professor/estagios'); %>
                        <%# o servidor mantém acesso direto; para os demais admins, Acompanhamento fica na Administração %>
                        <% if (!externo && papeis.servidor && user.cargo !== 'admin') { %>
                            <a href="/professor/acompanhamento" class="nav-link <%= ativo(emAcompanhamento) %>"><%- icone('olho') %> Acompanhamento</a>
                        <% } %>
                        <%# o setor de estágios é quem costuma receber o estudante: inclui o estágio %>
                        <% if (!externo && papeis.servidor) { %>
                            <a href="/professor/estagios" class="nav-link <%= ativo(emInclusao) %>"><%- icone('mais') %> Inclusão de estágios</a>
                        <% } %>
                        <% if (externo || papeis.orientador || papeis.supervisor) { %>
                            <a href="/professor/dashboard" class="nav-link <%= ativo(!emFichas && !emBancas && !emAdmin && !emAcompanhamento && !emInclusao && currentPath.startsWith('/professor') && currentPath !== '/professor/fichas') %>"><%- icone('usuarios') %> <%= externo ? 'Supervisionados' : 'Estagiários' %></a>
                            <% if (!externo && currentPath !== '/supervisor/pendente') { %>
                                <a href="/professor/fichas" class="nav-link <%= ativo(emFichas) %>"><%- icone('arquivo') %> Fichas</a>
                            <% } %>
                            <%# quem orienta marca as bancas; por isso a agenda é item do menu %>
                            <% if (!externo && papeis.orientador) { %>
                                <a href="/professor/bancas" class="nav-link <%= ativo(emBancas) %>"><%- icone('calendario') %> Agenda de bancas</a>
                            <% } %>
                        <% } %>
                    <% } %>
                </div>
                <% } %>

                <div class="nav-user" data-user-menu>
                    <button type="button" class="nav-user-profile nav-user-toggle" aria-expanded="false" aria-controls="menu-usuario" aria-haspopup="true" title="Menu da conta">
                        <span class="nav-avatar" aria-hidden="true"><%= user.avatarEmoji || user.nome.charAt(0).toUpperCase() %></span>
                        <span class="nav-user-name"><%= user.nome %></span>
                        <span class="nav-user-caret" aria-hidden="true"><%- icone('baixo') %></span>
                    </button>
                    <div class="nav-user-dropdown" id="menu-usuario" hidden>
                        <a href="/perfil" class="nav-user-item"><%- icone('usuario') %> Meu perfil</a>
                        <% if (user.cargo === 'admin') { %>
                            <a href="/professor/administracao" class="nav-user-item"><%- icone('escudo') %> Administração</a>
                        <% } %>
                        <div class="nav-user-separador" role="separator"></div>
                        <a href="/logout" class="nav-user-item nav-user-item-danger"><%- icone('sair') %> Sair</a>
                    </div>
                </div>
            <% } %>
        </nav>
    </div>
</header>
