PROJECT_NAME=fabrica-estagiarios
PORT=3000
APP_ENV=development
APP_VERSION=dev
SESSION_SECRET=dev-secret-troque-em-producao

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

POSTGRES_HOST=estagiarios-db
POSTGRES_PORT=5432
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=estagiarios-db

# Relatório semanal por e-mail (configure com o SMTP e o domínio públicos)
APP_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fabricadesoftware.videira@ifc.edu.br
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM=Fábrica de Estagiários <fabricadesoftware.videira@ifc.edu.br>

# SMTP exclusivo do Docker de desenvolvimento; mantenha apontado ao Mailpit.
# As variáveis DEV_SMTP_* sobrescrevem SMTP_* dentro do container web.
DEV_APP_URL=http://localhost:3000
DEV_SMTP_HOST=mailpit
DEV_SMTP_PORT=1025
DEV_SMTP_USER=nao-responda@localhost
DEV_SMTP_PASS=
DEV_SMTP_FROM="Fábrica de Estagiários <nao-responda@localhost>"
