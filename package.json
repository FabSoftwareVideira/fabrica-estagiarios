{
  "name": "fabrica-template",
  "version": "0.1.0",
  "description": "Template padrão para aplicações Node.js + Express + PostgreSQL com CI/CD via GitHub Actions e GHCR.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/scripts/runMigrations.js && nodemon src/server.js",
    "seed:dev": "node src/scripts/seedDev.js",
    "email:weekly": "node src/scripts/enviarRelatorioSemanalSupervisores.js",
    "email:reminders": "node src/scripts/lembretesAtividadesJob.js --enviar",
    "email:reminders:check": "node src/scripts/lembretesAtividadesJob.js --diagnostico",
    "email:reminders:dry-run": "node src/scripts/lembretesAtividadesJob.js --simular",
    "demo": "node src/scripts/demo.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"**/*.test.js\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20"
  }
}
